{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "types": ["vite/client"],

        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "exactOptionalPropertyTypes": true,

        // The migration runs file by file. JavaScript is still accepted, and is
        // deliberately not type-checked: checking it would report thousands of
        // errors in code that is about to be replaced, and a report nobody can
        // act on is a report nobody reads.
        "allowJs": true,
        "checkJs": false,

        // Vite compiles each module on its own and never reads this config for
        // emit, so the compiler is only ever asked whether the types hold.
        "noEmit": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src", "tests"]
}
