# Copy to .env and adjust, or export these directly.
#
# scripts/dev-db.sh prints a ready-made value:
#     eval "$(./scripts/dev-db.sh up | tail -1)"

# Required. PostgreSQL connection string.
DATABASE_URL=postgresql://studyplanner@localhost:5433/studyplanner

# Optional. Comma-separated browser origins allowed to call the API.
# Left unset, the API allows the usual local development ports.
# CORS_ORIGIN=http://localhost:5173

# Optional. Read the catalogue from the materialised view instead of the
# base tables. Faster, but needs the view refreshed after a catalogue change.
USE_CATALOG_MAT=0
